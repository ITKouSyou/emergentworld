# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
pip-wheel-metadata/

# ---------- 项目数据 ----------
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
.cache/

# 保留 data 目录本身
!data/.gitkeep

# ---------- 敏感信息 ----------
.env
.env.local
.env.*.local
# 注意：.env.example 会被保留（它不含真实 key）

# ---------- 备份 / 日志 ----------
*.bak
client/*.bak
*.log

# ---------- 构建与打包产物 ----------
# PyInstaller 的打包产物
build/
dist/
*.spec

# Godot 导出的执行文件（如果你不想把导出的 Game.exe 提交到 Git，请保持注释）
client/Game.*

# ---------- Godot ----------
client/.godot/
client/*.import/
.import/

# ---------- IDE / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时修复/补丁脚本 ----------
# 你的根目录下有大量自动修复脚本，忽略它们，避免污染仓库
fix_*.py
fix_*.ps1
fix_*.txt
patch_*.py
scaffold_*.py
scripts_history/*
# 如果想保留空的 scripts_history 目录，可以取消下面这行的注释并新建一个 .gitkeep 文件
# !scripts_history/.gitkeep

# 其他临时文件
*.tmp

# ---------- 游戏存档数据 ----------
data/
